# Copier en `.env` puis adapter.

# Chemin absolu (côté hôte) du dossier où la pipeline écrit ses données.
# Windows + Docker Desktop, pour D:/Etude/M2/M2Ops/projet_M2Ops/data :
#   /run/desktop/mnt/host/d/Etude/M2/M2Ops/projet_M2Ops/data
DATA_DIR_HOST=/chemin/absolu/vers/projet_M2Ops/data

# Compte de l'interface Kestra (email valide ; mot de passe 8+ caractères, 1 majuscule, 1 chiffre)
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=Admin1234

POSTGRES_PASSWORD=kestra
